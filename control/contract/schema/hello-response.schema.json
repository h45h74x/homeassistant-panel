            "enum": [
              "brightness",
              "warmth",
              "keep_awake",
              "refresh_screen",
              "battery_level",
              "charging",
              "frontlight_on",
              "power_state",
              "cpu_usage",
              "cpu_load",
              "memory_total",
              "memory_free",
              "storage_total",
              "storage_free",
              "rootfs_used_percent",
              "clock_offset",
              "uptime",
              "battery_temperature",
