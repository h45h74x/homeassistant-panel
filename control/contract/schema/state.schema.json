{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state",
  "type": "object",
  "properties": {
    "time": {
      "type": "integer"
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "brightness",
          "warmth",
          "keep_awake",
          "refresh_screen",
          "sleep",
          "battery_level",
          "charging",
          "frontlight_on",
          "power_state",
          "cpu_usage",
          "cpu_load",
          "memory_total",
          "memory_free",
          "storage_total",
          "storage_free",
          "rootfs_used_percent",
          "clock_offset",
          "uptime",
          "battery_temperature",
          "battery_voltage",
          "battery_current",
          "wifi_signal",
          "ip_address",
          "ssid",
          "mac_address",
          "kernel_version"
        ]
      },
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string",
          "null"
        ]
      }
    },
    "acks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "ok"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "time",
    "values",
    "acks"
  ],
  "additionalProperties": false
}
