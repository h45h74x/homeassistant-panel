{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commands-response",
  "type": "object",
  "properties": {
    "config_rev": {
      "type": "integer"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{1,16}$"
          },
          "capability": {
            "enum": [
              "brightness",
              "warmth",
              "keep_awake",
              "refresh_screen",
              "sleep",
              "battery_level",
              "charging",
              "frontlight_on",
              "power_state",
              "cpu_usage",
              "cpu_load",
              "memory_total",
              "memory_free",
              "storage_total",
              "storage_free",
              "rootfs_used_percent",
              "clock_offset",
              "uptime",
              "battery_temperature",
              "battery_voltage",
              "battery_current",
              "wifi_signal",
              "ip_address",
              "ssid",
              "mac_address",
              "kernel_version"
            ]
          },
          "value": {
            "type": [
              "number",
              "boolean",
              "null"
            ]
          },
          "issued_at": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "capability",
          "value",
          "issued_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "config_rev",
    "commands"
  ],
  "additionalProperties": false
}
